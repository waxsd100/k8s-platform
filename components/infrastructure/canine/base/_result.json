      },
      "name": "canine-ingress-from-tunnel-only",
      "namespace": "canine"
    },
    "spec": {
      "ingress": [
        {
          "from": [
            {
              "podSelector": {}
            }
          ]
        },
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "infra"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app": "cloudflared"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 3000,
              "protocol": "TCP"
            }
          ]
        }
      ],
      "podSelector": {},
      "policyTypes": [
        "Ingress"
      ]
    }
  }
