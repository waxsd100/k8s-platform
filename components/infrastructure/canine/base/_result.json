  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller"
      },
      "name": "canine",
      "namespace": "canine"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "canine-secret-key-base"
          },
          "secretKey": "secretKeyBase"
        },
        {
          "remoteRef": {
            "key": "canine-db-password"
          },
          "secretKey": "dbPassword"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "canine",
        "template": {
          "data": {
            "DATABASE_URL": "postgres://canine:{{ .dbPassword }}@127.0.0.1:5432/canine_production",
            "secret-key-base": "{{ .secretKeyBase }}"
          },
          "engineVersion": "v2"
        }
      }
    }
