[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "labels": {
        "app.kubernetes.io/instance": "canine",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "canine",
        "app.kubernetes.io/version": "1.0.0",
        "helm.sh/chart": "canine-0.1.10"
      },
      "name": "canine",
      "namespace": "canine"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/component": "web",
          "app.kubernetes.io/instance": "canine",
          "app.kubernetes.io/name": "canine"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
          },
          "labels": {
            "app.kubernetes.io/component": "web",
            "app.kubernetes.io/instance": "canine",
            "app.kubernetes.io/name": "canine"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-sm"
                        ]
                      }
                    ]
                  },
                  "weight": 100
                },
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-md"
                        ]
                      }
                    ]
                  },
                  "weight": 40
                }
              ],
              "requiredDuringSchedulingIgnoredDuringExecution": {
                "nodeSelectorTerms": [
                  {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-sm",
                          "platform-md",
                          "platform-lg"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "containers": [
            {
              "env": [
                {
                  "name": "DB_POOL_SIZE",
                  "value": "10"
                },
                {
                  "name": "RAILS_MAX_THREADS",
                  "value": "5"
                },
                {
                  "name": "WEB_CONCURRENCY",
                  "value": "2"
                },
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "DATABASE_URL",
                      "name": "canine"
                    }
                  }
                },
                {
                  "name": "PORT",
                  "value": "3000"
                },
                {
                  "name": "BOOT_MODE",
                  "value": "cluster"
                },
                {
                  "name": "SECRET_KEY_BASE",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "secret-key-base",
                      "name": "canine"
                    }
                  }
                },
                {
                  "name": "ALLOWED_HOSTNAME",
                  "value": "*"
                },
                {
                  "name": "ONBOARDING_METHOD",
                  "value": "normal"
                },
                {
                  "name": "APP_HOST",
                  "value": "http://localhost:3000"
                }
              ],
              "image": "ghcr.io/caninehq/canine:latest@sha256:7497df7b08a0e7a67857a3b306681dedf90b5168c2f024f6283f976eeed1213d",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 20,
                "timeoutSeconds": 5
              },
              "name": "canine",
              "ports": [
                {
                  "containerPort": 3000,
                  "name": "http",
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "1000m",
                  "memory": "1Gi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "512Mi"
                }
              },
              "securityContext": {},
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/rails/storage",
                  "name": "canine-storage"
                }
              ]
            }
          ],
          "initContainers": [
            {
              "args": [
                "--structured-logs",
                "--port=5432",
                "wax100:asia-northeast1:canine-db",
                "--private-ip"
              ],
              "image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.10.0",
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "sleep 5"
                    ]
                  }
                }
              },
              "name": "cloud-sql-proxy",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "restartPolicy": "Always",
              "securityContext": {
                "runAsNonRoot": true
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "platform"
          },
          "serviceAccountName": "canine",
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            }
          ],
          "volumes": [
            {
              "name": "canine-storage",
              "persistentVolumeClaim": {
                "claimName": "canine-storage"
              }
            }
          ]
        }
      }
    }
  }
]
