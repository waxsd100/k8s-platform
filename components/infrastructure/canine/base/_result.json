        "reloader.stakater.com/auto": "true"
      },
      "labels": {
        "app.kubernetes.io/instance": "canine",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "canine",
        "app.kubernetes.io/version": "1.0.0",
        "helm.sh/chart": "canine-0.1.10"
      },
      "name": "canine",
      "namespace": "canine"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/component": "web",
          "app.kubernetes.io/instance": "canine",
          "app.kubernetes.io/name": "canine"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller"
          },
          "labels": {
            "app.kubernetes.io/component": "web",
            "app.kubernetes.io/instance": "canine",
            "app.kubernetes.io/name": "canine"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "DB_POOL_SIZE",
                  "value": "5"
                },
                {
                  "name": "RAILS_MAX_THREADS",
                  "value": "5"
                },
                {
                  "name": "WEB_CONCURRENCY",
                  "value": "1"
                },
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "DATABASE_URL",
                      "name": "canine"
                    }
                  }
                },
                {
                  "name": "PORT",
                  "value": "3000"
                },
                {
                  "name": "BOOT_MODE",
                  "value": "cluster"
                },
                {
                  "name": "SECRET_KEY_BASE",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "secret-key-base",
                      "name": "canine"
                    }
                  }
                },
                {
                  "name": "ALLOWED_HOSTNAME",
                  "value": "*"
                },
                {
                  "name": "ONBOARDING_METHOD",
                  "value": "normal"
                },
                {
                  "name": "APP_HOST",
                  "value": "http://localhost:3000"
                }
              ],
              "image": "ghcr.io/caninehq/canine:latest@sha256:68b19aee1c646e7620e388876cc8c9ff0334bafbc4b0374c26c7a8c9ddba04ff",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "localhost"
                    }
                  ],
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 20,
                "timeoutSeconds": 5
              },
              "name": "canine",
              "ports": [
                {
                  "containerPort": 3000,
                  "name": "http",
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "localhost"
                    }
                  ],
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "1000m",
                  "memory": "2Gi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {},
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "localhost"
                    }
                  ],
                  "path": "/up",
                  "port": 3000
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/rails/storage",
                  "name": "canine-storage"
                }
              ]
            }
          ],
          "initContainers": [
            {
              "args": [
                "--structured-logs",
                "--port=5432",
                "--private-ip",
                "--max-sigterm-delay=10s",
                "--health-check",
                "--http-address=0.0.0.0",
                "--http-port=9090",
                "wax100:asia-northeast1:wax100-db"
              ],
              "image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.25.4@sha256:88501f0a695a586988add1b8a206fdf3f29f9a1a3deeb9b45ef2b1481ea6be83",
              "name": "cloud-sql-proxy",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "restartPolicy": "Always",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/startup",
                  "port": 9090
                },
                "periodSeconds": 2,
                "timeoutSeconds": 5
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "platform"
          },
          "serviceAccountName": "canine",
          "terminationGracePeriodSeconds": 45,
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            }
          ],
          "volumes": [
            {
              "name": "canine-storage",
              "persistentVolumeClaim": {
                "claimName": "canine-storage"
              }
            }
          ]
        }
      }
    }
