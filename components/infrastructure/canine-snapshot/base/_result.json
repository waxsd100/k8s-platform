[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
      },
      "name": "canine-snapshot",
      "namespace": "canine"
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
      },
      "name": "canine-snapshot-reader"
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "namespaces",
          "services",
          "configmaps",
          "persistentvolumeclaims",
          "serviceaccounts"
        ],
        "verbs": [
          "get",
          "list"
        ]
      },
      {
        "apiGroups": [
          "apps"
        ],
        "resources": [
          "deployments",
          "statefulsets",
          "daemonsets"
        ],
        "verbs": [
          "get",
          "list"
        ]
      },
      {
        "apiGroups": [
          "batch"
        ],
        "resources": [
          "jobs",
          "cronjobs"
        ],
        "verbs": [
          "get",
          "list"
        ]
      },
      {
        "apiGroups": [
          "networking.k8s.io"
        ],
        "resources": [
          "ingresses",
          "networkpolicies"
        ],
        "verbs": [
          "get",
          "list"
        ]
      },
      {
        "apiGroups": [
          "autoscaling"
        ],
        "resources": [
          "horizontalpodautoscalers"
        ],
        "verbs": [
          "get",
          "list"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
      },
      "name": "canine-snapshot-reader"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "canine-snapshot-reader"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "canine-snapshot",
        "namespace": "canine"
      }
    ]
  },
  {
    "apiVersion": "batch/v1",
    "kind": "CronJob",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
      },
      "name": "canine-snapshot",
      "namespace": "canine"
    },
    "spec": {
      "concurrencyPolicy": "Forbid",
      "failedJobsHistoryLimit": 3,
      "jobTemplate": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
          }
        },
        "spec": {
          "activeDeadlineSeconds": 3000,
          "backoffLimit": 2,
          "template": {
            "metadata": {
              "annotations": {
                "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
              }
            },
            "spec": {
              "containers": [
                {
                  "args": [
                    "set -euo pipefail\n\nWORK=$(mktemp -d)\ngit config --global user.email \"canine-snapshot@wax100.io\"\ngit config --global user.name \"canine-snapshot\"\n# トークンを remote URL に埋めない（git の失敗時にログへ出るため）\ngit config --global credential.helper store\nprintf 'https://x-access-token:%s@github.com\\n' \"${GITHUB_TOKEN}\" > ~/.git-credentials\nchmod 600 ~/.git-credentials\ngit clone --depth 1 \"https://github.com/${SNAPSHOT_REPO}.git\" \"${WORK}/repo\"\n\ncd \"${WORK}/repo\"\nrm -rf namespaces\nmkdir -p namespaces\n\nKINDS=\"deployment,statefulset,daemonset,cronjob,service,ingress,configmap,pvc,hpa,serviceaccount,networkpolicy\"\n\n# Config Sync 管理下 (昇格済み) の Namespace は Git が正なので対象外\nfor ns in $(kubectl get ns \\\n      -l 'app.kubernetes.io/managed-by!=configmanagement.gke.io' \\\n      -o jsonpath='{.items[*].metadata.name}'); do\n  case \" ${EXCLUDED_NAMESPACES} \" in\n    *\" ${ns} \"*) continue ;;\n  esac\n  case \"${ns}\" in\n    gke-managed-*|gmp-*) continue ;;\n  esac\n\n  out=\"namespaces/${ns}.yaml\"\n  mkdir -p \"$(dirname \"${out}\")\"\n\n  # status と、更新のたびに変わるメタデータを落として差分を安定させる。\n  # Secret は RBAC 上も取得できないため、機密は書き出されない。\n  kubectl get ${KINDS} -n \"${ns}\" -o yaml --show-managed-fields=false \\\n    | ruby -ryaml -e '\n        docs = YAML.load_stream(STDIN.read)\n        volatile_meta = %w[resourceVersion uid creationTimestamp generation selfLink managedFields]\n        volatile_anno = %w[\n          deployment.kubernetes.io/revision\n          kubectl.kubernetes.io/last-applied-configuration\n          kubectl.kubernetes.io/restartedAt\n        ]\n        clean = lambda do |o|\n          return unless o.is_a?(Hash)\n          o.delete(\"status\")\n          if (m = o[\"metadata\"]).is_a?(Hash)\n            volatile_meta.each { |k| m.delete(k) }\n            if (a = m[\"annotations\"]).is_a?(Hash)\n              volatile_anno.each { |k| a.delete(k) }\n              m.delete(\"annotations\") if a.empty?\n            end\n          end\n          (o[\"items\"] || []).each { |i| clean.call(i) }\n        end\n        docs.each { |d| clean.call(d) }\n        puts docs.compact.map(&:to_yaml).join\n      ' > \"${out}\"\ndone\n\ngit add -A\nif git diff --cached --quiet; then\n  echo \"no changes\"\n  exit 0\nfi\ngit commit -m \"snapshot: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\ngit push origin HEAD\n"
                  ],
                  "command": [
                    "/bin/bash",
                    "-c"
                  ],
                  "env": [
                    {
                      "name": "SNAPSHOT_REPO",
                      "value": "waxsd100/canine-apps-snapshot"
                    },
                    {
                      "name": "EXCLUDED_NAMESPACES",
                      "value": "kube-system kube-public kube-node-lease default canine canine-k8s-builder infra external-secrets kyverno reloader config-management-system config-management-monitoring resource-group-system"
                    },
                    {
                      "name": "GITHUB_TOKEN",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "GITHUB_TOKEN",
                          "name": "canine-snapshot"
                        }
                      }
                    }
                  ],
                  "image": "ghcr.io/caninehq/canine:latest@sha256:68b19aee1c646e7620e388876cc8c9ff0334bafbc4b0374c26c7a8c9ddba04ff",
                  "name": "snapshot",
                  "resources": {
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    },
                    "requests": {
                      "cpu": "50m",
                      "memory": "128Mi"
                    }
                  }
                }
              ],
              "nodeSelector": {
                "workload-type": "platform"
              },
              "restartPolicy": "Never",
              "serviceAccountName": "canine-snapshot",
              "tolerations": [
                {
                  "effect": "NoSchedule",
                  "key": "cloud.google.com/gke-spot",
                  "operator": "Equal",
                  "value": "true"
                }
              ]
            }
          },
          "ttlSecondsAfterFinished": 86400
        }
      },
      "schedule": "0 19 * * *",
      "successfulJobsHistoryLimit": 3
    }
  },
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook"
      },
      "name": "canine-snapshot",
      "namespace": "canine"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "canine-snapshot-github-token"
          },
          "secretKey": "GITHUB_TOKEN"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "canine-snapshot"
      }
    }
  }
]
