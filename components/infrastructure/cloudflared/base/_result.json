[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller",
        "reloader.stakater.com/auto": "true"
      },
      "labels": {
        "app": "cloudflared"
      },
      "name": "cloudflared",
      "namespace": "infra"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "cloudflared"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller"
          },
          "labels": {
            "app": "cloudflared"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "args": [
                "tunnel",
                "--metrics",
                "0.0.0.0:2000",
                "--grace-period",
                "15s",
                "--no-autoupdate",
                "run"
              ],
              "env": [
                {
                  "name": "TUNNEL_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "TUNNEL_TOKEN",
                      "name": "cloudflared-credentials"
                    }
                  }
                }
              ],
              "image": "cloudflare/cloudflared:2026.9.1@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4",
              "livenessProbe": {
                "failureThreshold": 4,
                "httpGet": {
                  "path": "/ready",
                  "port": 2000
                },
                "periodSeconds": 15,
                "timeoutSeconds": 5
              },
              "name": "cloudflared",
              "readinessProbe": {
                "failureThreshold": 2,
                "httpGet": {
                  "path": "/ready",
                  "port": 2000
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "startupProbe": {
                "failureThreshold": 12,
                "httpGet": {
                  "path": "/ready",
                  "port": 2000
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "system"
          },
          "priorityClassName": "platform-ingress",
          "terminationGracePeriodSeconds": 25
        }
      }
    }
  },
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller"
      },
      "name": "cloudflared-credentials",
      "namespace": "infra"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflared-tunnel-token"
          },
          "secretKey": "TUNNEL_TOKEN"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "cloudflared-credentials"
      }
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets,apps/namespaces/external-secrets/Deployment/external-secrets-webhook,apps/namespaces/external-secrets/Deployment/external-secrets-cert-controller"
      },
      "name": "cloudflared-deny-ingress",
      "namespace": "infra"
    },
    "spec": {
      "podSelector": {
        "matchLabels": {
          "app": "cloudflared"
        }
      },
      "policyTypes": [
        "Ingress"
      ]
    }
  }
]
