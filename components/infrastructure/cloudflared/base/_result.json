[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "reloader.stakater.com/auto": "true"
      },
      "labels": {
        "app": "cloudflared"
      },
      "name": "cloudflared",
      "namespace": "infra"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "cloudflared"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "cloudflared"
          }
        },
        "spec": {
          "containers": [
            {
              "args": [
                "tunnel",
                "--metrics",
                "0.0.0.0:2000",
                "--no-autoupdate",
                "run"
              ],
              "env": [
                {
                  "name": "TUNNEL_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "TUNNEL_TOKEN",
                      "name": "cloudflared-credentials"
                    }
                  }
                }
              ],
              "image": "cloudflare/cloudflared:2026.9.1",
              "livenessProbe": {
                "failureThreshold": 1,
                "httpGet": {
                  "path": "/ready",
                  "port": 2000
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 10
              },
              "name": "cloudflared",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                }
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "system"
          },
          "priorityClassName": "platform-ingress"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "cloudflared-credentials",
      "namespace": "infra"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflared-tunnel-token"
          },
          "secretKey": "TUNNEL_TOKEN"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "cloudflared-credentials"
      }
    }
  }
]
