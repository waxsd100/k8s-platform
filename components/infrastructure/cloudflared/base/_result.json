[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "reloader.stakater.com/auto": "true"
      },
      "labels": {
        "app": "cloudflared"
      },
      "name": "cloudflared",
      "namespace": "infra"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "cloudflared"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "cloudflared"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-xs"
                        ]
                      }
                    ]
                  },
                  "weight": 100
                },
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-sm"
                        ]
                      }
                    ]
                  },
                  "weight": 80
                },
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-md"
                        ]
                      }
                    ]
                  },
                  "weight": 40
                }
              ],
              "requiredDuringSchedulingIgnoredDuringExecution": {
                "nodeSelectorTerms": [
                  {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "platform-xs",
                          "platform-sm",
                          "platform-md",
                          "platform-lg"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "containers": [
            {
              "args": [
                "tunnel",
                "--metrics",
                "0.0.0.0:2000",
                "--no-autoupdate",
                "run"
              ],
              "env": [
                {
                  "name": "TUNNEL_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "TUNNEL_TOKEN",
                      "name": "cloudflared-credentials"
                    }
                  }
                }
              ],
              "image": "cloudflare/cloudflared:latest",
              "livenessProbe": {
                "failureThreshold": 1,
                "httpGet": {
                  "path": "/ready",
                  "port": 2000
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 10
              },
              "name": "cloudflared",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                }
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "platform"
          },
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "cloudflared-credentials",
      "namespace": "infra"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflared-tunnel-token"
          },
          "secretKey": "TUNNEL_TOKEN"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "cloudflared-credentials"
      }
    }
  }
]
