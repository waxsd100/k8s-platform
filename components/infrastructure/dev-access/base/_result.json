[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "labels": {
        "pod-security.kubernetes.io/audit": "restricted",
        "pod-security.kubernetes.io/enforce": "restricted",
        "pod-security.kubernetes.io/warn": "restricted"
      },
      "name": "dev-access"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ResourceQuota",
    "metadata": {
      "name": "dev-access-quota",
      "namespace": "dev-access"
    },
    "spec": {
      "hard": {
        "limits.memory": "512Mi",
        "pods": "5",
        "requests.cpu": "200m"
      }
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "Role",
    "metadata": {
      "name": "port-forward-relay",
      "namespace": "dev-access"
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "delete"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods/portforward"
        ],
        "verbs": [
          "get",
          "create"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "RoleBinding",
    "metadata": {
      "name": "wax100-dev-port-forward-relay",
      "namespace": "dev-access"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "Role",
      "name": "port-forward-relay"
    },
    "subjects": [
      {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "User",
        "name": "wax100-dev"
      }
    ]
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "deny-ingress",
      "namespace": "dev-access"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress"
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "egress-restrict",
      "namespace": "dev-access"
    },
    "spec": {
      "egress": [
        {
          "to": [
            {
              "namespaceSelector": {
                "matchExpressions": [
                  {
                    "key": "app.kubernetes.io/managed-by",
                    "operator": "NotIn",
                    "values": [
                      "configmanagement.gke.io"
                    ]
                  },
                  {
                    "key": "kubernetes.io/metadata.name",
                    "operator": "NotIn",
                    "values": [
                      "default",
                      "vela-system",
                      "velaux-store",
                      "infra",
                      "external-secrets",
                      "kyverno",
                      "reloader",
                      "headlamp",
                      "dev-access",
                      "resource-group-system",
                      "kube-system",
                      "kube-public",
                      "kube-node-lease",
                      "config-management-system",
                      "config-management-monitoring",
                      "gmp-system",
                      "gmp-public",
                      "gke-system",
                      "gke-connect",
                      "gke-managed-system"
                    ]
                  }
                ],
                "matchLabels": {
                  "usage.oam.dev/runtime": "target"
                }
              }
            }
          ]
        },
        {
          "ports": [
            {
              "port": 53,
              "protocol": "UDP"
            },
            {
              "port": 53,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "kube-system"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "k8s-app": "kube-dns"
                }
              }
            },
            {
              "ipBlock": {
                "cidr": "169.254.169.254/32"
              }
            }
          ]
        }
      ],
      "podSelector": {},
      "policyTypes": [
        "Egress"
      ]
    }
  }
]
