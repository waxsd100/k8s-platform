[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "name": "dev-access"
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "Role",
    "metadata": {
      "name": "port-forward-relay",
      "namespace": "dev-access"
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "delete"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods/portforward"
        ],
        "verbs": [
          "create"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "RoleBinding",
    "metadata": {
      "name": "wax100-dev-port-forward-relay",
      "namespace": "dev-access"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "Role",
      "name": "port-forward-relay"
    },
    "subjects": [
      {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "User",
        "name": "wax100-dev"
      }
    ]
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "deny-ingress",
      "namespace": "dev-access"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress"
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "egress-restrict",
      "namespace": "dev-access"
    },
    "spec": {
      "egress": [
        {
          "to": [
            {
              "namespaceSelector": {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/metadata.name",
                    "operator": "NotIn",
                    "values": [
                      "default",
                      "canine",
                      "canine-k8s-builder",
                      "canine-system",
                      "infra",
                      "external-secrets",
                      "kyverno",
                      "reloader",
                      "headlamp",
                      "dev-access"
                    ]
                  }
                ],
                "matchLabels": {
                  "caninemanaged": "true"
                }
              }
            }
          ]
        },
        {
          "ports": [
            {
              "port": 53,
              "protocol": "UDP"
            },
            {
              "port": 53,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "kube-system"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "k8s-app": "kube-dns"
                }
              }
            },
            {
              "ipBlock": {
                "cidr": "169.254.169.254/32"
              }
            }
          ]
        }
      ],
      "podSelector": {},
      "policyTypes": [
        "Egress"
      ]
    }
  }
]
