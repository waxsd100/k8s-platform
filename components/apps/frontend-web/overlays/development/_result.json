[
  {
    "apiVersion": "v1",
    "data": {
      "APP_THEME": "light",
      "LOG_LEVEL": "info"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "dev-frontend-env-config-7b7f8mmh9t",
      "namespace": "dev-frontend"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "dev-frontend-web",
      "namespace": "dev-frontend"
    },
    "spec": {
      "ports": [
        {
          "port": 80,
          "protocol": "TCP",
          "targetPort": 80
        }
      ],
      "selector": {
        "app": "frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "dev-frontend-web",
      "namespace": "dev-frontend"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "frontend-web"
          }
        },
        "spec": {
          "containers": [
            {
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "dev-frontend-env-config-7b7f8mmh9t"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/docker-hub-cache/library/nginx:alpine",
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "sleep 10"
                    ]
                  }
                }
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 80
                }
              ],
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "periodSeconds": 5
              }
            }
          ],
          "nodeSelector": {
            "cloud.google.com/gke-spot": "true",
            "workload-type": "app"
          },
          "terminationGracePeriodSeconds": 30,
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "environment",
              "operator": "Equal",
              "value": "development"
            }
          ],
          "topologySpreadConstraints": [
            {
              "labelSelector": {
                "matchLabels": {
                  "app": "frontend-web"
                }
              },
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "ScheduleAnyway"
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "policy/v1",
    "kind": "PodDisruptionBudget",
    "metadata": {
      "name": "dev-frontend-web-pdb",
      "namespace": "dev-frontend"
    },
    "spec": {
      "minAvailable": 1,
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      }
    }
  }
]
