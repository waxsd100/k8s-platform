[
  {
    "apiVersion": "v1",
    "data": {
      "APP_THEME": "light",
      "LOG_LEVEL": "info"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "dev-frontend-env-config-7b7f8mmh9t",
      "namespace": "dev-frontend"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "dev-frontend-web",
      "namespace": "dev-frontend"
    },
    "spec": {
      "ports": [
        {
          "port": 80,
          "protocol": "TCP",
          "targetPort": 80
        }
      ],
      "selector": {
        "app": "frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "dev-frontend-web",
      "namespace": "dev-frontend"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "frontend-web"
          }
        },
        "spec": {
          "containers": [
            {
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "dev-frontend-env-config-7b7f8mmh9t"
                  }
                },
                {
                  "secretRef": {
                    "name": "frontend-secret"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/docker-hub-cache/library/nginx:alpine",
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "sleep 10"
                    ]
                  }
                }
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "initialDelaySeconds": 3,
                "periodSeconds": 15
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 80
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "initialDelaySeconds": 3,
                "periodSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "periodSeconds": 5
              }
            }
          ],
          "nodeSelector": {
            "cloud.google.com/gke-spot": "true",
            "workload-type": "app"
          },
          "terminationGracePeriodSeconds": 30,
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "environment",
              "operator": "Equal",
              "value": "development"
            }
          ],
          "topologySpreadConstraints": [
            {
              "labelSelector": {
                "matchLabels": {
                  "app": "frontend-web"
                }
              },
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "ScheduleAnyway"
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "policy/v1",
    "kind": "PodDisruptionBudget",
    "metadata": {
      "name": "dev-frontend-web-pdb",
      "namespace": "dev-frontend"
    },
    "spec": {
      "minAvailable": 1,
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "dev-frontend-web",
      "namespace": "dev-frontend"
    },
    "spec": {
      "maxReplicas": 2,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 70,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "dev-frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "dev-frontend-external-secret",
      "namespace": "dev-frontend"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "frontend-db-password"
          },
          "secretKey": "DB_PASSWORD"
        },
        {
          "remoteRef": {
            "key": "frontend-api-key"
          },
          "secretKey": "API_KEY"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "frontend-secret"
      }
    }
  }
]
