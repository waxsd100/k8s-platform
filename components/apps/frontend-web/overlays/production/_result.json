[
  {
    "apiVersion": "v1",
    "data": {
      "APP_THEME": "light",
      "LOG_LEVEL": "info"
    },
    "kind": "ConfigMap",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "prod-frontend-env-config-7b7f8mmh9t",
      "namespace": "prod-frontend"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "prod-frontend-web",
      "namespace": "prod-frontend"
    },
    "spec": {
      "ports": [
        {
          "port": 80,
          "protocol": "TCP",
          "targetPort": 80
        }
      ],
      "selector": {
        "app": "frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "prod-frontend-web",
      "namespace": "prod-frontend"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
          },
          "labels": {
            "app": "frontend-web"
          }
        },
        "spec": {
          "containers": [
            {
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "prod-frontend-env-config-7b7f8mmh9t"
                  }
                },
                {
                  "secretRef": {
                    "name": "frontend-secret"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/docker-hub-cache/library/nginx:alpine",
              "livenessProbe": {
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "initialDelaySeconds": 3,
                "periodSeconds": 15
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 80
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "initialDelaySeconds": 3,
                "periodSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              }
            }
          ],
          "nodeSelector": {
            "workload-type": "app"
          },
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "environment",
              "operator": "Equal",
              "value": "production"
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "prod-frontend-web",
      "namespace": "prod-frontend"
    },
    "spec": {
      "maxReplicas": 3,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 70,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "prod-frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "prod-frontend-external-secret",
      "namespace": "prod-frontend"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "frontend-db-password"
          },
          "secretKey": "DB_PASSWORD"
        },
        {
          "remoteRef": {
            "key": "frontend-api-key"
          },
          "secretKey": "API_KEY"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "frontend-secret"
      }
    }
  }
]
