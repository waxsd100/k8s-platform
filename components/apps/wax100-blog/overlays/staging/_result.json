[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "iam.gke.io/gcp-service-account": "wax100-blog-sa@wax100.iam.gserviceaccount.com"
      },
      "name": "stg-wax100-blog-sa",
      "namespace": "stg-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "mysql",
      "database__connection__database": "ghost",
      "database__connection__host": "stg-wax100-blog-db",
      "database__connection__user": "ghost",
      "url": "https://stag.wax100.io"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "stg-wax100-blog-config-gm4ttcdcf9",
      "namespace": "stg-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "cloud.google.com/neg": "{\"ingress\": true}"
      },
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "stg-wax100-blog-db",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "port": 3306,
          "protocol": "TCP",
          "targetPort": 3306
        }
      ],
      "selector": {
        "app": "wax100-blog-db"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "stg-wax100-blog-pvc",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "10Gi"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "stg-wax100-blog-config-gm4ttcdcf9"
                  }
                },
                {
                  "secretRef": {
                    "name": "wax100-blog-secret"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/wax100-blog-repo/ghost:latest",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/",
                  "port": 2368
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "httpGet": {
                  "path": "/ghost/api/admin/site/",
                  "port": 2368
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 1000,
            "runAsNonRoot": true,
            "runAsUser": 1000
          },
          "volumes": [
            {
              "name": "ghost-storage",
              "persistentVolumeClaim": {
                "claimName": "stg-wax100-blog-pvc"
              }
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "stg-wax100-blog-db",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "wax100-blog-db"
        }
      },
      "serviceName": "stg-wax100-blog-db",
      "template": {
        "metadata": {
          "labels": {
            "app": "wax100-blog-db"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "MYSQL_DATABASE",
                  "value": "ghost"
                },
                {
                  "name": "MYSQL_USER",
                  "value": "ghost"
                }
              ],
              "envFrom": [
                {
                  "secretRef": {
                    "name": "wax100-blog-secret"
                  }
                }
              ],
              "image": "mysql:8.4",
              "livenessProbe": {
                "exec": {
                  "command": [
                    "mysqladmin",
                    "ping",
                    "-h",
                    "localhost"
                  ]
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "timeoutSeconds": 5
              },
              "name": "mysql",
              "ports": [
                {
                  "containerPort": 3306,
                  "name": "mysql"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "mysqladmin",
                    "ping",
                    "-h",
                    "localhost"
                  ]
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/mysql",
                  "name": "mysql-data"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 1001,
            "runAsNonRoot": true,
            "runAsUser": 1001
          }
        }
      },
      "volumeClaimTemplates": [
        {
          "metadata": {
            "name": "mysql-data"
          },
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "resources": {
              "requests": {
                "storage": "10Gi"
              }
            }
          }
        }
      ]
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "stg-wax100-blog-external-secret",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "wax100-blog-db-password"
          },
          "secretKey": "database__connection__password"
        },
        {
          "remoteRef": {
            "key": "wax100-blog-db-root-password"
          },
          "secretKey": "MYSQL_ROOT_PASSWORD"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "wax100-blog-secret"
      }
    }
  }
]
[
  {
    "apiVersion": "http.keda.sh/v1alpha1",
    "kind": "HTTPScaledObject",
    "metadata": {
      "name": "stg-wax100-blog-scaledobject",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "hosts": [
        "stg-blog.wax100.com"
      ],
      "replicas": {
        "max": 2,
        "min": 0
      },
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "wax100-blog",
        "port": 80,
        "service": "wax100-blog"
      },
      "targetPendingRequests": 10
    }
  }
]
[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "annotations": {
        "nginx.ingress.kubernetes.io/proxy-body-size": "50m"
      },
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "ingressClassName": "nginx",
      "rules": [
        {
          "host": "stag.wax100.io",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "stg-wax100-blog",
                    "port": {
                      "number": 80
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ]
    }
  }
]
