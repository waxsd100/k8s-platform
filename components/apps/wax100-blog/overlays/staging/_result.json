[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets",
        "iam.gke.io/gcp-service-account": "wax100-blog-sa@wax100.iam.gserviceaccount.com"
      },
      "name": "stg-wax100-blog-sa",
      "namespace": "stg-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "sqlite3",
      "database__connection__filename": "/var/lib/ghost/content/data/ghost.db",
      "url": "https://stag.wax100.io"
    },
    "kind": "ConfigMap",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-blog-config-kd4dkcmdff",
      "namespace": "stg-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "cloud.google.com/neg": "{\"ingress\": true}",
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-blog-pvc",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "10Gi"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets",
            "reloader.stakater.com/auto": "true"
          },
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "stag-pool"
                        ]
                      }
                    ]
                  },
                  "weight": 100
                }
              ]
            }
          },
          "containers": [
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "stg-wax100-blog-config-kd4dkcmdff"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/wax100-blog-repo/ghost:latest",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/",
                  "port": 2368
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "httpGet": {
                  "path": "/ghost/api/admin/site/",
                  "port": 2368
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                },
                {
                  "mountPath": "/var/lib/ghost/content/data",
                  "name": "ghost-storage",
                  "subPath": "data"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 1000,
            "runAsNonRoot": true,
            "runAsUser": 1000
          },
          "serviceAccountName": "stg-wax100-blog-sa",
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            }
          ],
          "volumes": [
            {
              "name": "ghost-storage",
              "persistentVolumeClaim": {
                "claimName": "stg-wax100-blog-pvc"
              }
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-blog-external-secret",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "data": [],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "wax100-blog-secret"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/depends-on": "apps/namespaces/external-secrets/Deployment/external-secrets"
      },
      "name": "stg-wax100-tls-external-secret",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflare-origin-cert"
          },
          "secretKey": "tls.crt"
        },
        {
          "remoteRef": {
            "key": "cloudflare-origin-key"
          },
          "secretKey": "tls.key"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "name": "wax100-tls-secret",
        "template": {
          "type": "kubernetes.io/tls"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "http.keda.sh/v1alpha1",
    "kind": "HTTPScaledObject",
    "metadata": {
      "name": "stg-wax100-blog-scaledobject",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "hosts": [
        "stag.wax100.io"
      ],
      "replicas": {
        "max": 1,
        "min": 0
      },
      "scaleTargetRef": {
        "deployment": "stg-wax100-blog",
        "port": 80,
        "service": "stg-wax100-blog"
      },
      "targetPendingRequests": 10
    }
  }
]
[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "annotations": {
        "nginx.ingress.kubernetes.io/proxy-body-size": "50m"
      },
      "name": "stg-wax100-blog",
      "namespace": "stg-wax100-blog"
    },
    "spec": {
      "ingressClassName": "nginx",
      "rules": [
        {
          "host": "stag.wax100.io",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "stg-wax100-blog",
                    "port": {
                      "number": 80
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ],
      "tls": [
        {
          "hosts": [
            "stag.wax100.io"
          ],
          "secretName": "wax100-tls-secret"
        }
      ]
    }
  }
]
