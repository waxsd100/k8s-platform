[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "iam.gke.io/gcp-service-account": "wax100-blog-sa@wax100.iam.gserviceaccount.com"
      },
      "name": "prod-wax100-blog-sa",
      "namespace": "prod-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "mysql",
      "database__connection__database": "ghost",
      "database__connection__host": "127.0.0.1",
      "database__connection__user": "ghost",
      "url": "https://wax100.io"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "prod-wax100-blog-config-6t246df5t9",
      "namespace": "prod-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "cloud.google.com/backend-config": "{\"default\": \"prod-wax100-blog-backend-config\"}",
        "cloud.google.com/neg": "{\"ingress\": true}"
      },
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "gke-gcsfuse/ephemeral-storage-limit": "3Gi",
            "gke-gcsfuse/memory-limit": "100Mi",
            "gke-gcsfuse/volumes": "true",
            "reloader.stakater.com/auto": "true"
          },
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "requiredDuringSchedulingIgnoredDuringExecution": {
                "nodeSelectorTerms": [
                  {
                    "matchExpressions": [
                      {
                        "key": "node.kubernetes.io/instance-type",
                        "operator": "In",
                        "values": [
                          "e2-medium",
                          "e2-standard-2",
                          "e2-standard-4"
                        ]
                      },
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "prod-sm",
                          "prod-md",
                          "prod-lg"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "containers": [
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "prod-wax100-blog-config-6t246df5t9"
                  }
                },
                {
                  "secretRef": {
                    "name": "wax100-blog-secret",
                    "optional": true
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/wax100-blog-repo/ghost:latest",
              "livenessProbe": {
                "failureThreshold": 3,
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "successThreshold": 1,
                "tcpSocket": {
                  "port": 2368
                },
                "timeoutSeconds": 3
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "successThreshold": 1,
                "tcpSocket": {
                  "port": 2368
                },
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                }
              ]
            },
            {
              "args": [
                "--structured-logs",
                "--port=3306",
                "wax100:asia-northeast1:wax100-db",
                "--private-ip"
              ],
              "image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.10.0",
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "sleep 5"
                    ]
                  }
                }
              },
              "name": "cloud-sql-proxy",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "securityContext": {
                "runAsNonRoot": true
              }
            }
          ],
          "securityContext": {
            "fsGroup": 1000,
            "runAsNonRoot": true,
            "runAsUser": 1000
          },
          "serviceAccountName": "prod-wax100-blog-sa",
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "dedicated",
              "operator": "Equal",
              "value": "prod-app"
            },
            {
              "effect": "NoSchedule",
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            }
          ],
          "volumes": [
            {
              "csi": {
                "driver": "gcsfuse.csi.storage.gke.io",
                "volumeAttributes": {
                  "bucketName": "wax100-blog",
                  "mountOptions": "implicit-dirs,uid=1000,gid=1000"
                }
              },
              "name": "ghost-storage"
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "prod-wax100-blog-hpa",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "maxReplicas": 3,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 70,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "prod-wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "cloud.google.com/v1",
    "kind": "BackendConfig",
    "metadata": {
      "name": "prod-wax100-blog-backend-config",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "connectionDraining": {
        "drainingTimeoutSec": 30
      },
      "healthCheck": {
        "port": 2368,
        "type": "TCP"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "prod-wax100-blog-external-secret",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "wax100-db-password"
          },
          "secretKey": "database__connection__password"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "prod-wax100-blog-secret"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "prod-wax100-tls-external-secret",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflare-origin-cert"
          },
          "secretKey": "tls.crt"
        },
        {
          "remoteRef": {
            "key": "cloudflare-origin-key"
          },
          "secretKey": "tls.key"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "name": "wax100-tls-secret",
        "template": {
          "type": "kubernetes.io/tls"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "networking.gke.io/v1beta1",
    "kind": "FrontendConfig",
    "metadata": {
      "name": "prod-wax100-blog-frontend-config",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "redirectToHttps": {
        "enabled": true,
        "responseCodeName": "MOVED_PERMANENTLY_DEFAULT"
      }
    }
  }
]
[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "annotations": {
        "kubernetes.io/ingress.global-static-ip-name": "prod-wax100-blog-ip",
        "networking.gke.io/v1beta1.FrontendConfig": "prod-wax100-blog-frontend-config"
      },
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "ingressClassName": "gce",
      "rules": [
        {
          "host": "wax100.io",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "prod-wax100-blog",
                    "port": {
                      "number": 80
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ],
      "tls": [
        {
          "hosts": [
            "wax100.io"
          ],
          "secretName": "wax100-tls-secret"
        }
      ]
    }
  }
]
