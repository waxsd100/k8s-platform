[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "iam.gke.io/gcp-service-account": "wax100-blog-sa@wax100.iam.gserviceaccount.com"
      },
      "name": "prod-wax100-blog-sa",
      "namespace": "prod-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "mysql",
      "database__connection__database": "ghost",
      "database__connection__host": "127.0.0.1",
      "database__connection__user": "ghost",
      "url": "https://wax100.io"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "prod-wax100-blog-config-6t246df5t9",
      "namespace": "prod-wax100-blog"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "cloud.google.com/neg": "{\"ingress\": true}"
      },
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "prod-wax100-blog-pvc",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "10Gi"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "preference": {
                    "matchExpressions": [
                      {
                        "key": "node-pool",
                        "operator": "In",
                        "values": [
                          "prod-pool"
                        ]
                      }
                    ]
                  },
                  "weight": 100
                }
              ]
            }
          },
          "containers": [
            {
              "args": [
                "--structured-logs",
                "--port=3306",
                "PROJECT_ID:REGION:INSTANCE_NAME"
              ],
              "image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.10.0",
              "name": "cloud-sql-proxy",
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "securityContext": {
                "runAsNonRoot": true
              }
            },
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "prod-wax100-blog-config-6t246df5t9"
                  }
                },
                {
                  "secretRef": {
                    "name": "wax100-blog-secret"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/wax100-blog-repo/ghost:latest",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/",
                  "port": 2368
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "httpGet": {
                  "path": "/ghost/api/admin/site/",
                  "port": 2368
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 1000,
            "runAsNonRoot": true,
            "runAsUser": 1000
          },
          "serviceAccountName": "prod-wax100-blog-sa",
          "tolerations": [
            {
              "operator": "Exists"
            }
          ],
          "volumes": [
            {
              "name": "ghost-storage",
              "persistentVolumeClaim": {
                "claimName": "prod-wax100-blog-pvc"
              }
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "prod-wax100-blog-hpa",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "maxReplicas": 5,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 70,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "prod-wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "prod-wax100-blog-external-secret",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "wax100-blog-db-password"
          },
          "secretKey": "database__connection__password"
        },
        {
          "remoteRef": {
            "key": "wax100-blog-db-root-password"
          },
          "secretKey": "MYSQL_ROOT_PASSWORD"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "wax100-blog-secret"
      }
    }
  }
]
[
  {
    "apiVersion": "networking.gke.io/v1",
    "kind": "ManagedCertificate",
    "metadata": {
      "name": "prod-wax100-blog-cert",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "domains": [
        "wax100.io"
      ]
    }
  }
]
[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "annotations": {
        "kubernetes.io/ingress.global-static-ip-name": "prod-wax100-blog-ip",
        "networking.gke.io/managed-certificates": "prod-wax100-blog-cert"
      },
      "name": "prod-wax100-blog",
      "namespace": "prod-wax100-blog"
    },
    "spec": {
      "ingressClassName": "gce",
      "rules": [
        {
          "host": "wax100.io",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "prod-wax100-blog",
                    "port": {
                      "number": 80
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ]
    }
  }
]
