[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "mysql",
      "database__connection__database": "ghost",
      "database__connection__host": "wax100-blog-db",
      "database__connection__user": "ghost",
      "url": "https://blog.wax100.com"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "wax100-blog-config-t6ff2g7tff"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "wax100-blog-pvc"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "10Gi"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": null,
                  "name": "wax100-blog-config"
                },
                {
                  "name": "wax100-blog-secret",
                  "secretRef": null
                }
              ],
              "image": "ghost:6-alpine",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/",
                  "port": 2368
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 15
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "httpGet": {
                  "path": "/ghost/api/admin/site/",
                  "port": 2368
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 10
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "ghost-storage",
              "persistentVolumeClaim": {
                "claimName": "wax100-blog-pvc"
              }
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "wax100-blog-external-secret"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "wax100-blog-db-password"
          },
          "secretKey": "database__connection__password"
        },
        {
          "remoteRef": {
            "key": "wax100-blog-db-root-password"
          },
          "secretKey": "MYSQL_ROOT_PASSWORD"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "wax100-blog-secret"
      }
    }
  }
]
