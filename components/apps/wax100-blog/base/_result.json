[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "annotations": {
        "iam.gke.io/gcp-service-account": "wax100-blog-sa@wax100.iam.gserviceaccount.com"
      },
      "name": "wax100-blog-sa"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "data": {
      "database__client": "mysql",
      "database__connection__database": "ghost",
      "database__connection__host": "wax100-db",
      "database__connection__user": "ghost",
      "url": "https://wax100.io"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "wax100-blog-config-t57g2ghg27"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "cloud.google.com/neg": "{\"ingress\": true}"
      },
      "name": "wax100-blog"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 2368
        }
      ],
      "selector": {
        "app": "wax100-blog"
      }
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "wax100-blog-pvc"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "10Gi"
        }
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "wax100-blog"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "wax100-blog"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "reloader.stakater.com/auto": "true"
          },
          "labels": {
            "app": "wax100-blog"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "wax100-blog-config-t57g2ghg27"
                  }
                },
                {
                  "secretRef": {
                    "name": "wax100-blog-secret",
                    "optional": true
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/wax100-blog-repo/ghost:latest",
              "livenessProbe": {
                "failureThreshold": 3,
                "initialDelaySeconds": 30,
                "periodSeconds": 15,
                "successThreshold": 1,
                "tcpSocket": {
                  "port": 2368
                },
                "timeoutSeconds": 3
              },
              "name": "web",
              "ports": [
                {
                  "containerPort": 2368
                }
              ],
              "readinessProbe": {
                "failureThreshold": 5,
                "initialDelaySeconds": 15,
                "periodSeconds": 10,
                "successThreshold": 1,
                "tcpSocket": {
                  "port": 2368
                },
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/ghost/content/images",
                  "name": "ghost-storage",
                  "subPath": "images"
                },
                {
                  "mountPath": "/var/lib/ghost/content/media",
                  "name": "ghost-storage",
                  "subPath": "media"
                },
                {
                  "mountPath": "/var/lib/ghost/content/files",
                  "name": "ghost-storage",
                  "subPath": "files"
                },
                {
                  "mountPath": "/var/lib/ghost/content/data",
                  "name": "ghost-storage",
                  "subPath": "data"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 1000,
            "runAsNonRoot": true,
            "runAsUser": 1000
          },
          "serviceAccountName": "wax100-blog-sa",
          "volumes": [
            {
              "name": "ghost-storage",
              "persistentVolumeClaim": {
                "claimName": "wax100-blog-pvc"
              }
            }
          ]
        }
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "wax100-blog-external-secret"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "wax100-db-password"
          },
          "secretKey": "database__connection__password"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "creationPolicy": "Owner",
        "name": "wax100-blog-secret"
      }
    }
  }
]
[
  {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "wax100-tls-external-secret"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "cloudflare-origin-cert"
          },
          "secretKey": "tls.crt"
        },
        {
          "remoteRef": {
            "key": "cloudflare-origin-key"
          },
          "secretKey": "tls.key"
        }
      ],
      "refreshInterval": "1h",
      "secretStoreRef": {
        "kind": "ClusterSecretStore",
        "name": "gcp-secret-store"
      },
      "target": {
        "name": "wax100-tls-secret",
        "template": {
          "type": "kubernetes.io/tls"
        }
      }
    }
  }
]
