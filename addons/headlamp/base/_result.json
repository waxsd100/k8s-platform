      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "view"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "headlamp-user",
        "namespace": "headlamp"
      }
