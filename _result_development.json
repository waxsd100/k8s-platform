[
  {
    "apiVersion": "v1",
    "data": {
      "APP_THEME": "light",
      "LOG_LEVEL": "info"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "development-frontend-env-config-7b7f8mmh9t",
      "namespace": "frontend-development"
    }
  }
]
[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "development-frontend-web",
      "namespace": "frontend-development"
    },
    "spec": {
      "ports": [
        {
          "port": 80,
          "protocol": "TCP",
          "targetPort": 80
        }
      ],
      "selector": {
        "app": "frontend-web"
      }
    }
  }
]
[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "development-frontend-web",
      "namespace": "frontend-development"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "frontend-web"
          }
        },
        "spec": {
          "containers": [
            {
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "development-frontend-env-config-7b7f8mmh9t"
                  }
                }
              ],
              "image": "asia-northeast1-docker.pkg.dev/wax100/docker-hub-cache/library/nginx:alpine",
              "name": "web",
              "ports": [
                {
                  "containerPort": 80
                }
              ],
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/",
                  "port": 80
                },
                "periodSeconds": 5
              }
            }
          ],
          "topologySpreadConstraints": [
            {
              "labelSelector": {
                "matchLabels": {
                  "app": "frontend-web"
                }
              },
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "ScheduleAnyway"
            }
          ]
        }
      }
    }
  }
]
