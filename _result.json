[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "development-frontend-web",
      "namespace": "frontend-development"
    },
    "spec": {
      "ports": [
        {
          "protocol": "TCP",
          "port": 80,
          "targetPort": 80
        }
      ],
      "selector": {
        "app": "frontend-web"
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "development-frontend-web",
      "namespace": "frontend-development"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "frontend-web"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "frontend-web"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "web",
              "image": "nginx:1.25.0-alpine",
              "ports": [
                {
                  "containerPort": 80
                }
              ]
            }
          ]
        }
      }
    }
  }
]
